# Binnacle log-query endpoint for lifecycle/binnacle-tail.sh
# Copy to secrets/binnacle.agent_visible_env (gitignored) and fill in the
# real host and port. The .agent_visible_env extension means AI coding
# agents may read it; it holds no secrets, just the local endpoint.
#
# An exported BINNACLE_URL environment variable takes precedence over this file.

BINNACLE_URL=https://binnacle-host:8088
