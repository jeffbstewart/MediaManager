    "carPlayListLoadFailed" : {
      "comment" : "CarPlay, the row shown in place of a list that failed to load for any other reason. States what happened; never ask the driver to act.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t load this list."
          }
        }
      }
    },
    "carPlayNotSignedInDetail" : {
      "comment" : "CarPlay, second line under “Not signed in”. Read by a driver: say the fix waits until they are not driving; never ask them to act now.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in on your phone when you’re not driving."
          }
        }
      }
    },
    "carPlayNotSignedInTitle" : {
      "comment" : "CarPlay, the only row shown when the phone has no signed-in account, so there is no music to offer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not signed in"
          }
        }
      }
    },
    "carPlayOfflineNothingDownloadedDetail" : {
      "comment" : "CarPlay, second line under “Offline”: together they read “Offline, but there’s no music downloaded”. States the situation only; never ask the driver to act.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There’s no music downloaded on this phone."
          }
        }
      }
    },
    "carPlayOfflineNothingDownloadedTitle" : {
      "comment" : "CarPlay, the only row shown when the phone is offline (Offline Mode, or no network) and no music is downloaded, so there is nothing to play.",
