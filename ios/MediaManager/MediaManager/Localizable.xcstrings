{
  "sourceLanguage" : "en",
  "strings" : {
    "carPlayListLoadFailed" : {
      "comment" : "CarPlay, the row shown in place of a list that failed to load for any other reason. States what happened; never ask the driver to act.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn’t load this list."
          }
        }
      }
    },
    "carPlayNotSignedInDetail" : {
      "comment" : "CarPlay, second line under “Not signed in”. Read by a driver: say the fix waits until they are not driving; never ask them to act now.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in on your phone when you’re not driving."
          }
        }
      }
    },
    "carPlayNotSignedInTitle" : {
      "comment" : "CarPlay, the only row shown when the phone has no signed-in account, so there is no music to offer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not signed in"
          }
        }
      }
    },
    "carPlayOfflineModeDetail" : {
      "comment" : "CarPlay, second line under “Offline Mode is on”. States the limitation only; never ask the driver to change anything.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloaded music isn’t in CarPlay yet."
          }
        }
      }
    },
    "carPlayOfflineModeTitle" : {
      "comment" : "CarPlay, the only row shown when the phone is signed in but Offline Mode is on; CarPlay cannot yet offer downloaded music, so there is nothing to play. “Offline Mode” is the name of the app setting.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline Mode is on"
          }
        }
      }
    },
    "carPlayServerChangedDetail" : {
      "comment" : "CarPlay, second line under “Server changed”. Read by a driver: say the fix waits until they are not driving; never ask them to act now.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the server on your phone when you’re not driving."
          }
        }
      }
    },
    "carPlayServerChangedTitle" : {
      "comment" : "CarPlay, the only row shown when the server no longer matches the one the phone trusted (its identity changed), so there is no music to offer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server changed"
          }
        }
      }
    },
    "carPlayServerUnreachable" : {
      "comment" : "CarPlay, the row shown in place of a list when the phone can’t reach the user’s media server. States what happened; never ask the driver to act.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can’t reach your server right now."
          }
        }
      }
    },
    "carPlayTermsNotAcceptedDetail" : {
      "comment" : "CarPlay, second line under “Server terms not accepted”; “them” is the terms. Read by a driver: say the fix waits until they are not driving; never ask them to act now.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accept them on your phone when you’re not driving."
          }
        }
      }
    },
    "carPlayTermsNotAcceptedTitle" : {
      "comment" : "CarPlay, the only row shown when the account hasn't accepted the server's terms of use yet, so there is no music to offer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server terms not accepted"
