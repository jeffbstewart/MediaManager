{
  "sourceLanguage" : "en",
  "strings" : {
    "carplay.unavailable.notSignedIn.detail" : {
      "comment" : "CarPlay, second line under “Not signed in”. Read by a driver: it must say the fix waits until they are not driving, and must never ask them to act now.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in on your phone when you’re not driving."
          }
        }
      }
    },
    "carplay.unavailable.notSignedIn.title" : {
      "comment" : "CarPlay, the only row shown when the phone has no signed-in account, so there is no music to offer.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not signed in"
          }
        }
      }
    },
    "carplay.unavailable.serverChanged.detail" : {
      "comment" : "CarPlay, second line under “Server changed”. Read by a driver: it must say the fix waits until they are not driving, and must never ask them to act now.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check the server on your phone when you’re not driving."
          }
        }
      }
    },
    "carplay.unavailable.serverChanged.title" : {
      "comment" : "CarPlay, the only row shown when the server no longer matches the one the phone trusted (its identity changed), so there is no music to offer.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server changed"
          }
        }
      }
    },
    "carplay.unavailable.termsNotAccepted.detail" : {
      "comment" : "CarPlay, second line under “Server terms not accepted”; “them” is the terms. Read by a driver: it must say the fix waits until they are not driving, and must never ask them to act now.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accept them on your phone when you’re not driving."
          }
        }
      }
    },
    "carplay.unavailable.termsNotAccepted.title" : {
      "comment" : "CarPlay, the only row shown when the account hasn't accepted the server's terms of use yet, so there is no music to offer.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server terms not accepted"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
